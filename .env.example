# ───────────────────────── Agent Metra API ─────────────────────────
# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3001

# Database (Supabase Postgres pooler URL)
PRODUCT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# false = no SSL (local Postgres only). true = verify the server certificate.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=15

# Login tokens – REQUIRED. Use 64+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional: previous JWT_SECRET while rotating (old logins keep working until they expire)
JWT_SECRET_LEGACY=
# Login lifetime in seconds (default 7 days)
JWT_TTL_SECONDS=604800
# Optional: separate secret for the Meta login "state" (JWT_SECRET is used when empty)
META_OAUTH_STATE_SECRET=

# Web app address(es) allowed to call the API (comma separated). APP_PUBLIC_URL is always allowed.
CORS_ORIGINS=https://app.agentmetra.lk
# Number of proxies in front of the API (Nginx = 1, Cloudflare + Nginx = 2). Used for real client IPs in rate limits.
TRUST_PROXY=1
# Requests per minute per IP for normal API calls (login / sign-up have stricter limits)
RATE_LIMIT_PER_MINUTE=1200
BODY_SIZE_LIMIT_MB=25

# Webhook security
# Meta signs WhatsApp / Messenger / Instagram webhooks with META_APP_SECRET (set below). Extra Meta apps: comma separated secrets.
META_APP_SECRETS_EXTRA=
# true (default) = refuse WhatsApp Meta webhooks without a valid signature
WHATSAPP_WEBHOOK_REQUIRE_SIGNATURE=true
# Random value – added as ?token= to the Evolution webhook URL and checked on every Evolution webhook
EVOLUTION_WEBHOOK_TOKEN=

EVOLUTION_API_BASE=http://YOUR_EVOLUTION_HOST:8080
EVOLUTION_API_KEY=your-evolution-api-key
# Webhook applied automatically on instance create (POST /webhook/set + create body)
EVOLUTION_WEBHOOK_URL=https://your-n8n-or-bot.example.com/webhook/evolution
# Meta inbound: Nest verifies webhook + agent routing, then forwards raw Meta POST to n8n AI workflow
N8N_WHATSAPP_WEBHOOK_URL=https://your-n8n.example.com/webhook/whatsapp-ai
N8N_FORWARD_META_INBOUND=true
# Shared secret for n8n → Nest WhatsApp send (set same value in n8n env N8N_INTERNAL_API_KEY)
N8N_INTERNAL_API_KEY=
# Optional: n8n uses this as Nest API base for Meta sends (PUBLIC_API_BASE_URL also works)
# NEST_WHATSAPP_SEND_URL=https://api.yourdomain.com/v1/api
EVOLUTION_WEBHOOK_EVENTS=MESSAGES_UPSERT
EVOLUTION_WEBHOOK_BY_EVENTS=true
EVOLUTION_WEBHOOK_BASE64=false
# Instance settings on create + POST /settings/set (Evolution Manager toggles)
# true | false | 1 | 0 | yes | no — overridable per request via read_messages on POST /instance
EVOLUTION_READ_MESSAGES=true
EVOLUTION_ALWAYS_ONLINE=true
EVOLUTION_GROUPS_IGNORE=true

# Meta Facebook Page + Instagram (posts/images AND Messenger / Instagram DM chats)
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3001/v1/api/integrations/meta/callback
META_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/settings
META_GRAPH_API_VERSION=v22.0
# Recommended: Facebook Login for Business configuration ID (Meta app → Facebook Login for Business → Configurations).
# When set, scope is NOT sent — permissions are defined in that configuration.
META_OAUTH_CONFIG_ID=
# WhatsApp Embedded Signup configuration ID (separate from Facebook Login for Business).
META_WHATSAPP_CONFIG_ID=
# Token configured for the WhatsApp webhook verification callback.
META_WEBHOOK_VERIFY_TOKEN=
# Fallback when META_OAUTH_CONFIG_ID is empty (legacy Facebook Login only).
# instagram_basic is deprecated — use instagram_business_basic.
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_messaging,pages_manage_metadata,instagram_basic,instagram_manage_messages

# Pending chat timeout. HOURS wins over AGENT_PENDING_TIMEOUT_MINUTES (e.g. 0.0833 = 5 minutes)
AGENT_PENDING_TIMEOUT_HOURS=24
AGENT_ROUTING_CHECK_MINUTES=1

# Real-time agent inbox (optional — inbox also polls every 8s)
PUSHER_APP_ID=''
PUSHER_KEY=''
PUSHER_SECRET=''
PUSHER_CLUSTER='ap2'
PUSHER_HOST=
PUSHER_PORT=

CHAT_MEDIA_DIR=./storage/chat-media
CHAT_MEDIA_SECRET='change-me-long-random-string'
PUBLIC_API_BASE_URL=https://your-real-api-domain.com/v1/api



# Google Identity Services OAuth client ID used to verify /auth/google ID tokens.
GOOGLE_CLIENT_ID=

# Meta Page / Instagram message webhook (configure this URL in Meta app):
# https://YOUR_API_HOST/v1/api/integrations/meta/messages/webhook
META_MESSAGING_VERIFY_TOKEN=any-random-string-you-also-type-in-meta
# With SALES_BOT_URL set, the AI sales bot also answers Messenger and Instagram chats. See MESSENGER_INSTAGRAM_SETUP.md

# ── Python sales bot (replaces the n8n AI workflow when SALES_BOT_URL is set) ──
# Leave SALES_BOT_URL empty to keep n8n exactly as before.
SALES_BOT_URL=http://localhost:8000
# Same value as BOT_API_KEY in the Python sales bot's .env
SALES_BOT_API_KEY=change-me-long-random-string
# Customer simulator in the dashboard (nothing is sent to WhatsApp). false in production.
SALES_BOT_TEST_MODE=false
# Wait this long for more customer messages before the bot replies (ms)
SALES_BOT_DEBOUNCE_MS=3000
SALES_BOT_TIMEOUT_MS=90000

# ── Agent Metra platform (super admin) ──
# Comma separated login emails of the Metrocoding team – they get the "Agent Metra admin" area
SUPER_ADMIN_EMAILS=admin@metrocoding.lk
# ── Billing (PayHere) ──
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# true = sandbox.payhere.lk (testing), false = live
PAYHERE_SANDBOX=true
# optional: lets companies cancel auto-renew from the app (PayHere Subscription Manager API)
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# dashboard address (PayHere return / cancel pages)
APP_PUBLIC_URL=https://app.agentmetra.lk
# 6-digit two-step PIN used to register new WhatsApp numbers (random if empty)
WHATSAPP_REGISTRATION_PIN=

# ── Verification codes (sign-up, change email / WhatsApp) ──
# Email over SMTP (Gmail app password, Zoho, cPanel, SES SMTP, Resend SMTP …)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agent Metra <no-reply@yourdomain.lk>"
# WhatsApp codes from Metrocoding's own WhatsApp Cloud API number (approved AUTHENTICATION template)
OTP_WHATSAPP_PHONE_NUMBER_ID=
OTP_WHATSAPP_TOKEN=
OTP_WHATSAPP_TEMPLATE=verification_code
OTP_WHATSAPP_LANG=en_US
# Optional SMS fallback (Notify.lk)
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=
# Local testing only: returns the codes in the response and logs them. NEVER true in production.
OTP_DEV_MODE=false
# false = old sign-up without codes (not recommended)
REGISTRATION_VERIFICATION=true

# ── Mobile app push notifications (Firebase) ──
# Firebase console → Project settings → Service accounts → Generate new private key → paste the JSON on ONE line
FCM_SERVICE_ACCOUNT_JSON=

# ── Marketing (Part G) ──
# Uses META_APP_ID / META_APP_SECRET / META_GRAPH_API_VERSION / PUBLIC_API_BASE_URL / APP_PUBLIC_URL.
# In the Meta app add this Valid OAuth Redirect URI: {PUBLIC_API_BASE_URL}/public/marketing/meta/callback
# Only for automated tests (a fake Meta server) – leave EMPTY in production:
META_GRAPH_BASE_URL=

# Short links / QR codes: https://<this>/l/abc123 (default: the origin of PUBLIC_API_BASE_URL). Optional short domain.
SHORT_LINK_BASE_URL=
